{
	"name": "flix.ldmax.nl",
	"description": "Enspired by the [NDE Heritage FLix](https://github.com/netwerk-digitaal-erfgoed/heritageflix), this project aims to create a simple but visualy attractive website using SPARQL queries.",
	"private": true,
	"author": {
		"name": "Mark Lindeman",
		"email": "mark@lindeman.it"
	},
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"preversion": "node scripts/preversion-check.js",
		"postversion": "git push origin main --follow-tags",
		"test": "node --test tests/*.test.js",
		"check:config": "node scripts/check-config.js"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/n3": "^1.26.5",
		"@types/rdf-ext": "^2.5.2",
		"@types/sparqljs": "^3.1.12",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"globals": "^17.13.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@comunica/query-sparql": "^5.4.1",
		"@rdfjs/data-model": "^2.1.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"flowbite-svelte-icons": "^3.1.0",
		"marked": "^18.1.1",
		"n3": "^2.13.12",
		"rdf-ext": "^2.6.0",
		"sparqljs": "^3.7.4",
		"tify": "^0.35.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "^24.21.0"
	}
}
